# Пэд: аккорд C-E-G-B из расстроенных пил, медленная атака
# sfunc synth -f examples/patches/pad.sfx -d 6 -o pad.wav
voice = saw(phase(note("C3"))) + saw(phase(note("C3") * 1.006))
voice = voice + saw(phase(note("E3"))) + saw(phase(note("G3") * 0.995)) + saw(phase(note("B3")))
lowpass(voice, 900 ) * adsr(1.5, 0.5, 0.8, 2)
